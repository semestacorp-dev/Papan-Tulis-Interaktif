rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Validator
    function isValidUser(data) {
      return data.email is string && data.email.size() <= 100
        && data.displayName is string && data.displayName.size() <= 100
        && data.role is string && (data.role == 'teacher' || data.role == 'student' || data.role == 'bgtk_admin')
        && (data.schoolName == null || (data.schoolName is string && data.schoolName.size() <= 200));
    }

    // --- User Profiles Collection ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) 
                     && (!incoming().diff(existing()).affectedKeys().hasAny(['role'])); // Prevent self-privilege escalation
      allow delete: if isOwner(userId);
    }

    // --- Whiteboard Sessions Collection ---
    match /whiteboard_sessions/{sessionId} {
      allow read: if true; // Any classroom participant can read
      allow create: if isSignedIn() && incoming().roomCode is string && incoming().roomCode.size() <= 50;
      allow update: if true; // Permit drawing & slide syncing
      allow delete: if isSignedIn();
      
      // Subcollections
      match /elements/{elementId} {
        allow read, write: if true;
      }
      match /participants/{participantId} {
        allow read, write: if true;
      }
      match /chat/{messageId} {
        allow read, write: if true;
      }
    }

    // --- Materi Pembelajaran Collection ---
    match /materi_pembelajaran/{materiId} {
      allow read: if true;
      allow create, update: if isSignedIn() && incoming().title is string && incoming().title.size() <= 200;
      allow delete: if isSignedIn();
    }

    // --- Quizzes Collection ---
    match /quizzes/{quizId} {
      allow read, write: if true;

      match /submissions/{submissionId} {
        allow read, write: if true;
      }
    }

    // --- BGTK Records Collection ---
    match /bgtk_records/{recordId} {
      allow read, write: if isSignedIn();
    }
  }
}
